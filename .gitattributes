# Textdateien im Repo einheitlich mit LF speichern (Windows lokal, später Linux in der GitHub Action)
* text=auto

# Generierte Dateien des Rechenwerks: auch in der Arbeitskopie immer LF, so wie compute.py sie schreibt.
# Sonst macht core.autocrlf unter Windows beim Pull CRLF daraus, der nächste Lauf schreibt LF zurück,
# und git hält die Dateien für geändert (der folgende Pull bricht dann ab).
data/season_*.json text eol=lf
app/data/*.json text eol=lf

# ESPN-Rohdaten: byte-genau wie geliefert, eine Zeile je Datei (bis ~3 MB).
# Ausnahmen (Auszüge): transactions/kona_league_communication_* (ohne Chat) und wNN/ros.json.
# "binary" = kein Zeilenende-Umbau, kein Text-Diff, kein Merge – bei Konflikten neu abrufen.
# Ansehen: python -m json.tool data/raw/2026/w01/mTeam.json
data/raw/** binary

# Ausnahme: die Stadion-Tabelle ist von Hand gepflegt (Session 6) – Text-Diff und Merge erwünscht, immer LF.
# Pool-Auszug (pool/latest.json) und Wetterdateien schreibt der Tageslauf mit LF; sie bleiben wie die übrigen Rohdaten binär.
data/raw/*/nfl/stadien.json diff merge text eol=lf
